## Nano syntax highlighting for JSON and JSON with comments
## Written by Caleb Denney https://github.com/Denney-tech
##
## Colors follow VS Code's Dark+ theme, with Ansible-style status colors:
## green = true/ok, red = false/error, yellow = warning (see README.md).
## Rules are applied in order, and later rules repaint earlier ones.

syntax json "\.(json|jsonc|json5|code-workspace)$" "(^|/)\.(babelrc|eslintrc|prettierrc|jshintrc)$" "(^|/)(tsconfig|jsconfig)\.json$"
header "^[[:space:]]*[{[][[:space:]]*$"
comment "//"

## Numbers
color #bca "-?\<[[:digit:]]+(\.[[:digit:]]+)?([eE][-+]?[[:digit:]]+)?\>"
## Literals: true = ok (green), false = red, null as a constant
color green "\<true\>"
color red "\<false\>"
color #59d "\<null\>"
## Punctuation (before strings, so a ":" inside a string keeps the string color)
color normal "[][{}:,]"
## Strings, then keys (a string followed by a colon) in VS Code's property color
color #c97 "\"([^\"\\]|\\.)*\""
color #9df "\"([^\"\\]|\\.)*\"[[:space:]]*:"
## Escapes inside strings
color #c8c "\\([\"\\/bfnrt]|u[[:xdigit:]]{4})"
## Comments (JSONC / JSON5)
color italic,#695 "(^|[[:space:]])//.*$"
color italic,#695 start="/\*" end="\*/"
## Errors: trailing comma before a closing bracket on the same line, trailing whitespace
color ,red ",[[:space:]]*[]}]"
color ,red "[[:space:]]+$"
